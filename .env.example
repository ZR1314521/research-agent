# The only model configuration used by this project. Fill locally; never commit a key.
RESEARCH_AGENT_LLM_PROVIDER=deepseek
RESEARCH_AGENT_LLM_PROTOCOL=openai-compatible
RESEARCH_AGENT_LLM_MODEL=
RESEARCH_AGENT_LLM_BASE_URL=
RESEARCH_AGENT_LLM_API_KEY=
RESEARCH_AGENT_LLM_TIMEOUT=120
# 0 lets the provider/model use its native maximum output.
RESEARCH_AGENT_LLM_MAX_TOKENS=0
RESEARCH_AGENT_LLM_RETRY=0
RESEARCH_AGENT_PROVIDER_MAX_CONCURRENCY=1
# 0 means the adapter or provider supplies the context limit.
RESEARCH_AGENT_CONTEXT_WINDOW=0
# Optional harness working-set ceiling. Keep this lower than the model window.
RESEARCH_AGENT_CONTEXT_BUDGET=32000
# Maximum size of one tool observation sent back to the model.
RESEARCH_AGENT_CONTEXT_OBSERVATION_BUDGET=4000
# Space kept for the model's response and provider-side formatting.
RESEARCH_AGENT_CONTEXT_OUTPUT_RESERVE=8000
# Optional emergency runaway guard only. Set 0 for unlimited native model/tool turns.
RESEARCH_AGENT_EMERGENCY_TURN_LIMIT=50

# Optional literature-source settings.
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_MAILTO=
PUBMED_EMAIL=
PUBMED_API_KEY=
